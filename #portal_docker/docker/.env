# Ścieżka do ORYGINAŁÓW (Tylko odczyt)
# Na Synology: /volume1/photo_sesion/originals
# Na Windows np.: C:/Users/Ja/Pictures/photo_sesion/originals
PATH_ORIGINALS=/volume1/photo_sesion/originals

# Ścieżka do PREVIEW/DANYCH (Odczyt i Zapis)
# Na Synology: /volume1/photo_sesion/proofing_photo
# Na Windows np.: C:/Users/Ja/Pictures/photo_sesion/proofing_photo
PATH_PROOFING=/volume1/photo_sesion/proofing_photo


# --- KONFIGURACJA BAZY DANYCH (Tego brakowało!) ---
# Hasło główne do serwera bazy (root)
DB_ROOT_PASS=root_secret

# Użytkownik, z którego będzie korzystać aplikacja
DB_USER=wf_user

# Hasło dla aplikacji
DB_PASS=wf_password